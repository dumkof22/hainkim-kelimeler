{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dumkof22/hainkim-kelimeler/schema/index.schema.json",
  "title": "Hain Kim? paket listesi",
  "description": "index.json: hangi paketlerin hangi sırayla gösterileceği. Ayrıntılar için docs/WORDS.md.",
  "type": "object",
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Dosya biçiminin sürümü. Uygulama tanımadığı daha yeni bir sürümü yok sayar."
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "file": {
            "type": "string",
            "description": "Depo köküne göre yol. Verilmezse packs/<id>.json."
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "false ise kategori gizlenir."
          }
        }
      }
    }
  }
}
