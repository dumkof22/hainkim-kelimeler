{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dumkof22/hainkim-kelimeler/schema/pack.schema.json",
  "title": "Hain Kim? kelime paketi",
  "description": "Tek bir kategori: packs/<id>.json. Ayrıntılar için docs/WORDS.md.",
  "type": "object",
  "required": ["id", "name", "words"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "index.json'daki id ile aynı olmalı."
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "description": "Kategori kartındaki tek bir emoji."
    },
    "name": { "$ref": "#/definitions/localizedText" },
    "drawable": {
      "type": "boolean",
      "default": true,
      "description": "false ise kategori Çizim modunda görünmez."
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/word" }
    }
  },
  "definitions": {
    "localizedText": {
      "type": "object",
      "description": "Dil kodu → metin. Eksik dilde önce en, sonra tr gösterilir.",
      "minProperties": 1,
      "propertyNames": { "enum": ["tr", "en", "es", "fr", "de", "it", "pt", "ru", "ar", "zh"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "word": {
      "type": "object",
      "required": ["word"],
      "anyOf": [{ "required": ["clues"] }, { "required": ["clue"] }],
      "properties": {
        "word": { "$ref": "#/definitions/localizedText" },
        "clues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/localizedText" },
          "description": "Her turda biri rastgele seçilir."
        },
        "clue": { "$ref": "#/definitions/localizedText" },
        "drawable": {
          "type": "boolean",
          "default": true,
          "description": "false ise kelime Çizim modunda çıkmaz."
        }
      }
    }
  }
}
